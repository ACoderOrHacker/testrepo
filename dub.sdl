name "oe"
description "The Ox-Extends Library, based on Ox codebase."
authors "ACoderOrHacker"
copyright "Copyright (C) ACoderOrHacker"
license "Apache-2.0"
targetName "oed"
targetType "library"
targetPath "build"
sourcePath "source"

configuration "unittest" {
    targetType "executable"
    mainSourceFile "tests/test.d"
    dependency "unit-threaded" version="~>0.10.8"
}

configuration "benchmark" {
    targetType "executable"
    mainSourceFile "benchmarks/benchmarks.d"
}
